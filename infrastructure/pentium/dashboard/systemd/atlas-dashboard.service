[Unit]
Description=Atlas read-only observability dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/pentium-agent/dashboard/atlas_dashboard.py
WorkingDirectory=%h/pentium-agent/dashboard
Restart=on-failure
RestartSec=3
MemoryHigh=128M
MemoryMax=192M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/pentium-agent
ReadWritePaths=%h/pentium-agent/atlas/runtime
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
