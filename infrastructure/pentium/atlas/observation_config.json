{
  "schema_version": 1,
  "sources": {
    "pentium.self": {
      "interval_seconds": 30,
      "timeout_seconds": 5,
      "max_backoff_seconds": 120,
      "cooldown_seconds": 60,
      "jitter_seconds": 0
    },
    "core": {
      "interval_seconds": 30,
      "timeout_seconds": 8,
      "max_backoff_seconds": 180,
      "cooldown_seconds": 60,
      "jitter_seconds": 0
    },
    "x99": {
      "interval_seconds": 60,
      "timeout_seconds": 8,
      "max_backoff_seconds": 240,
      "cooldown_seconds": 60,
      "jitter_seconds": 0
    },
    "wifi.presence": {
      "interval_seconds": 60,
      "timeout_seconds": 10,
      "max_backoff_seconds": 300,
      "cooldown_seconds": 60,
      "jitter_seconds": 5,
      "interface_env": "ATLAS_WIFI_INTERFACE",
      "presence_window_seconds": 180,
      "max_devices": 256
    }
  }
}
