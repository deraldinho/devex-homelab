[Unit]
Description=Atlas always-on local voice runtime
After=default.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/pentium-agent
EnvironmentFile=-%h/pentium-agent/atlas/runtime/observation.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m atlas.voice_daemon
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=default.target
