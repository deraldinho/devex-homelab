[Unit]
Description=Atlas canonical health supervisor
After=network-online.target atlas-observation.service atlas-cognitive.service
Wants=network-online.target atlas-observation.service atlas-cognitive.service

[Service]
Type=simple
WorkingDirectory=%h/pentium-agent
EnvironmentFile=-%h/pentium-agent/atlas/runtime/observation.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m atlas.health_supervisor_daemon
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
MemoryHigh=128M
MemoryMax=192M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/pentium-agent/atlas/runtime
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
