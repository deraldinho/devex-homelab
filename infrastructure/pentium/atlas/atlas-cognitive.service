[Unit]
Description=Atlas always-on cognitive runtime
After=network-online.target atlas-observation.service
Wants=network-online.target atlas-observation.service

[Service]
Type=simple
WorkingDirectory=%h/pentium-agent
EnvironmentFile=-%h/pentium-agent/atlas/runtime/observation.env
EnvironmentFile=-%h/pentium-agent/atlas/runtime/discord.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m atlas.cognitive_daemon
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
MemoryHigh=256M
MemoryMax=384M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/pentium-agent/atlas/runtime /run/user/%U
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
