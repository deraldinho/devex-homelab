# CP-SENTRY-P4 template only — do not enable without OS principal segregation.
ATLAS_SENTRY_V2_RELAY_ENABLED=1
ATLAS_SENTRY_V2_RELAY_SOCKET=/run/atlas-sentry-relay/receipts.sock
ATLAS_SENTRY_V2_RELAY_ACTION_JOURNAL=/var/lib/atlas-sentry-health/actions.jsonl
ATLAS_SENTRY_V2_RELAY_STATUS_FILE=/var/lib/atlas-sentry-health/relay-status.json
ATLAS_SENTRY_V2_RELAY_ALLOWED_UID=REPLACE_WITH_EXECUTOR_UID
ATLAS_SENTRY_V2_RELAY_GROUP_GID=REPLACE_WITH_SHARED_GROUP_GID
ATLAS_SENTRY_V2_TRUST_KEYRING_FILE=/etc/atlas-sentry/trusted-public-keys.json
