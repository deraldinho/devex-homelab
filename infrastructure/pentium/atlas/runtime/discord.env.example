# Configuração do Atlas Discord Gateway
# ATENÇÃO: NUNCA versionar o arquivo discord.env com tokens reais.
# Copie este arquivo para ~/pentium-agent/atlas/runtime/discord.env e ajuste as permissões para 0600.

# Token de autenticação do bot DevExMachina no Discord Developer Portal
ATLAS_DISCORD_BOT_TOKEN="SEU_TOKEN_DISCORD_AQUI"

# ID do Servidor Discord Autorizado (DevExMachina.com.br)
ATLAS_DISCORD_GUILD_IDS="1409654606849638440"

# IDs de canais monitorados para escuta ativa e comandos (use * para permitir todos do servidor)
ATLAS_DISCORD_CHANNEL_IDS="1476441917020700773,1473703460385063065,1476390422506111127,1473703295611568213,1470069813580795954"

# IDs de usuários com permissão de interagir com o bot (* permite qualquer membro do servidor)
ATLAS_DISCORD_USER_IDS="*"

# IDs de operadores com privilégios administrativos (!canal, !msg, !limpar)
ATLAS_DISCORD_ADMIN_USER_IDS="1022699113562775552"

# Mapeamento funcional de canais dedicados da governança do Homelab
ATLAS_DISCORD_ALERT_CHANNEL_ID="1476441917020700773"
ATLAS_DISCORD_MEMORY_CHANNEL_ID="1473703460385063065"
ATLAS_DISCORD_NOTES_CHANNEL_ID="1476390422506111127"
ATLAS_DISCORD_CONSOLE_CHANNEL_ID="1473703295611568213"

# Intervalo em segundos de atualização do Live Dashboard fixo no canal de console
ATLAS_DISCORD_DASHBOARD_INTERVAL_S="30.0"
