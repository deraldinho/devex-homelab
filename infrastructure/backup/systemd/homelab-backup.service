[Unit]
Description=DevEx HomeLab Automated Restic Backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/homelab/backup/restic-backup.sh
EnvironmentFile=/etc/homelab/backup.env
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
