if(NOT DEFINED OPENSSL_EXECUTABLE)
  message(FATAL_ERROR "OPENSSL_EXECUTABLE is required")
endif()
if(NOT DEFINED OUT_DIR)
  message(FATAL_ERROR "OUT_DIR is required")
endif()
file(MAKE_DIRECTORY "${OUT_DIR}")
set(ca_key "${OUT_DIR}/ca.key.pem")
set(ca_crt "${OUT_DIR}/ca.crt.pem")
set(server_key "${OUT_DIR}/server.key.pem")
set(server_csr "${OUT_DIR}/server.csr.pem")
set(server_crt "${OUT_DIR}/server.crt.pem")
set(client_key "${OUT_DIR}/client.key.pem")
set(client_csr "${OUT_DIR}/client.csr.pem")
set(client_crt "${OUT_DIR}/client.crt.pem")
execute_process(COMMAND "${OPENSSL_EXECUTABLE}" req -x509 -newkey rsa:2048 -nodes -keyout "${ca_key}" -out "${ca_crt}" -days 1 -subj /CN=Atlas-Test-CA RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "failed to create CA")
endif()
execute_process(COMMAND "${OPENSSL_EXECUTABLE}" req -newkey rsa:2048 -nodes -keyout "${server_key}" -out "${server_csr}" -subj /CN=atlas-server RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "failed to create server csr")
endif()
execute_process(COMMAND "${OPENSSL_EXECUTABLE}" x509 -req -in "${server_csr}" -CA "${ca_crt}" -CAkey "${ca_key}" -CAcreateserial -out "${server_crt}" -days 1 RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "failed to sign server cert")
endif()
execute_process(COMMAND "${OPENSSL_EXECUTABLE}" req -newkey rsa:2048 -nodes -keyout "${client_key}" -out "${client_csr}" -subj /CN=x99 RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "failed to create client csr")
endif()
execute_process(COMMAND "${OPENSSL_EXECUTABLE}" x509 -req -in "${client_csr}" -CA "${ca_crt}" -CAkey "${ca_key}" -CAserial "${OUT_DIR}/ca.crt.srl" -out "${client_crt}" -days 1 RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "failed to sign client cert")
endif()
file(REMOVE "${server_csr}" "${client_csr}" "${OUT_DIR}/ca.crt.srl")
set(core_key "${OUT_DIR}/core.key.pem")
set(core_csr "${OUT_DIR}/core.csr.pem")
set(core_crt "${OUT_DIR}/core.crt.pem")
execute_process(COMMAND "${OPENSSL_EXECUTABLE}" req -newkey rsa:2048 -nodes -keyout "${core_key}" -out "${core_csr}" -subj /CN=core RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "failed to create core csr")
endif()
execute_process(COMMAND "${OPENSSL_EXECUTABLE}" x509 -req -in "${core_csr}" -CA "${ca_crt}" -CAkey "${ca_key}" -CAcreateserial -out "${core_crt}" -days 1 RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "failed to sign core cert")
endif()
file(REMOVE "${ca_key}" "${core_csr}" "${OUT_DIR}/ca.crt.srl")
